# Copy to .env and fill in. NEVER commit .env (it is git-ignored). NEVER share the key.
# The key is read only by the Python backend; it is never sent to the browser or written to any file.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown on screen during the demo (can also be edited in the UI).
STUDENT_NAME=
ROLL_NUMBER=

# ---- Course budget rules (enforced in the backend; these are the defaults) ----
# Move limit for a run. Decision models stop at 20, Claude / frontier models at 5.
MAX_MOVES=20
DECISION_MAX_MOVES=20
FRONTIER_MAX_MOVES=5
# Total OpenRouter requests ever made with this key (cannot be set above 65).
OPENROUTER_TOTAL_CAP=65
# Extra attempts per turn. Keep 0: every retry counts against the budget.
MAX_RETRIES=0
RETRY_BACKOFF_S=1.5
REQUEST_TIMEOUT_S=120
HISTORY_WINDOW=10

# Claude Opus 5.5 (chat completions) thinking effort: none | minimal | low | medium | high | xhigh
OPUS_REASONING_EFFORT=medium
CHAT_MAX_TOKENS=8000

# ---- Ollama (local open-source models, free and unlimited) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_DECISION_MODEL=turintech/clef-flash-artemis:iq3_xxs
OLLAMA_QWEN_MODEL=qwen3.5:2b
OLLAMA_DEEPSEEK_MODEL=deepseek-r1:1.5b
OLLAMA_GEMMA_MODEL=gemma3:4b
# Thinking for Qwen / DeepSeek: false = much faster on a laptop CPU
OLLAMA_THINK=false
OLLAMA_TIMEOUT_S=300
OLLAMA_NUM_CTX=4096

# Exact optimum search depth (bidirectional BFS).
OPTIMAL_MAX_DEPTH=10

# Optional OpenRouter attribution headers
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=Rubiks Cube Race
